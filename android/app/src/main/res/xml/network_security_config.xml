<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- SBI Payment Gateway -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">sbi.co.in</domain>
        <domain includeSubdomains="true">sbi.in</domain>
        <domain includeSubdomains="true">sbiuat.bank.in</domain>

        <!-- Certificate pinning for SBI -->
        <pin-set expiration="2026-09-27">
            <!-- SBI Leaf Certificate -->
            <pin digest="SHA-256">9cfpRdt3u5byy0K2nxVHhWnByC+qBa0BS+RG60siZpQ=</pin>
            <!-- RapidSSL Intermediate CA (DigiCert) -->
            <pin digest="SHA-256">E3tYcwo9CiqATmKtpMLW5V+pzIq+ZoDmpXSiJlXGmTo=</pin>
        </pin-set>
    </domain-config>

    <!-- PayU Payment Gateway -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">payu.in</domain>
        <domain includeSubdomains="true">secure.payu.in</domain>
        <domain includeSubdomains="true">api.payu.in</domain>
        <domain includeSubdomains="true">payucdn.com</domain>
        <domain includeSubdomains="true">secure.payucdn.com</domain>
    </domain-config>

    <!-- Our API Server (iamsup.in) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">iamsup.in</domain>

        <!-- Certificate pinning for our API -->
        <pin-set expiration="2026-09-27">
            <!-- iamsup.in Leaf Certificate -->
            <pin digest="SHA-256">9cfpRdt3u5byy0K2nxVHhWnByC+qBa0BS+RG60siZpQ=</pin>
            <!-- RapidSSL Intermediate CA (DigiCert) -->
            <pin digest="SHA-256">E3tYcwo9CiqATmKtpMLW5V+pzIq+ZoDmpXSiJlXGmTo=</pin>
        </pin-set>
    </domain-config>

    <!-- Default policy: reject all untrusted certs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">.</domain>
    </domain-config>

</network-security-config>

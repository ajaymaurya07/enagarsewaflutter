platform :ios, '16.0'
use_frameworks!

project 'eNagarsewa.xcodeproj'

target 'eNagarsewa' do
  # Firebase — push notifications (firebase_messaging) and Crashlytics (firebase_crashlytics).
  pod 'FirebaseCore'
  pod 'FirebaseMessaging'
  pod 'FirebaseCrashlytics'

  # PayU CheckoutPro (payu_checkoutpro_flutter). PayUCheckoutBridge compiles without it
  # (`#if canImport(PayUCheckoutProKit)`), but payments need it in real builds.
  pod 'PayUIndia-CheckoutPro'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end

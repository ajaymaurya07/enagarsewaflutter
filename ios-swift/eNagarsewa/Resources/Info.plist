<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- App identity -->
    <key>CFBundleName</key>
    <string>e-Nagarsewa</string>
    <key>CFBundleIdentifier</key>
    <string>com.enagarsewa.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.2.1</string>
    <key>CFBundleVersion</key>
    <string>17</string>

    <!-- Base URL — override via xcconfig per environment -->
    <key>BASE_URL</key>
    <string>https://iamsup.in/ulb_property_tax/</string>

    <!-- Scene lifecycle -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- Push notifications (background fetch) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- Privacy usage descriptions -->
    <key>NSCameraUsageDescription</key>
    <string>Camera access is needed to attach photos to grievance submissions.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Photo library access is needed to attach images to grievance submissions.</string>

    <key>NSContactsUsageDescription</key>
    <string>Contact access is used to suggest your phone number and email during sign-up.</string>

    <!-- UI -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- ATS — allow our pinned host; block everything else -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>iamsup.in</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>

</dict>
</plist>
